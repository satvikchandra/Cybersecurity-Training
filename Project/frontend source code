<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dictionary Attack Simulator</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-dark text-light">
  <div class="container mt-5">
    <h1 class="text-center mb-4">Dictionary Attack Simulator</h1>

    <!-- Upload Wordlist -->
    <div class="mb-3">
      <label for="wordlist" class="form-label">Upload Wordlist (.txt)</label>
      <input type="file" class="form-control" id="wordlist">
    </div>

    <!-- Target Hash -->
    <div class="mb-3">
      <label for="hash" class="form-label">Target Hash</label>
      <input type="text" class="form-control" id="hash" placeholder="Enter target hash">
    </div>

    <!-- Algorithm Selection -->
    <div class="mb-3">
      <label for="algorithm" class="form-label">Hash Algorithm</label>
      <select class="form-select" id="algorithm">
        <option value="sha256">SHA-256</option>
        <option value="md5">MD5</option>
        <option value="sha1">SHA-1</option>
      </select>
    </div>

    <!-- Start Attack -->
    <button class="btn btn-primary w-100" onclick="startAttack()">Start Attack</button>

    <!-- Results -->
    <div id="results" class="mt-4">
      <h3>Results</h3>
      <div class="progress mb-3">
        <div id="progressBar" class="progress-bar" role="progressbar" style="width: 0%">0%</div>
      </div>
      <p id="status">Waiting for attack...</p>
      <p id="match"></p>
      <p id="stats"></p>
    </div>
  </div>

  <script>
    async function startAttack() {
      const hash = document.getElementById("hash").value;
      const algorithm = document.getElementById("algorithm").value;
      const fileInput = document.getElementById("wordlist");

      if (!fileInput.files[0]) {
        alert("Please upload a wordlist file!");
        return;
      }

      // Upload file
      const formData = new FormData();
      formData.append("file", fileInput.files[0]);
      const uploadRes = await fetch("/upload", { method: "POST", body: formData });
      const uploadData = await uploadRes.json();

      if (uploadData.error) {
        alert(uploadData.error);
        return;
      }

      // Run attack
      const attackRes = await fetch("/attack", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          hash: hash,
          filepath: uploadData.filepath,
          algorithm: algorithm
        })
      });
      const result = await attackRes.json();

      // Update UI
      document.getElementById("status").innerText = result.match ? "Password Found!" : "No Match Found";
      document.getElementById("match").innerText = result.match ? `Matched Password: ${result.match}` : "";
      document.getElementById("stats").innerText = `Attempts: ${result.attempts}, Time Taken: ${result.time_taken}s, Algorithm: ${result.algorithm}`;
      document.getElementById("progressBar").style.width = "100%";
      document.getElementById("progressBar").innerText = "100%";
    }
  </script>
</body>
</html>
